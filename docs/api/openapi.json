{
  "openapi": "3.1.0",
  "info": {
    "title": "API FitZone — Gestión de Gimnasio",
    "description": "\nSistema RESTful de gestión de membresías, reservaciones de clases y control de acceso para el gimnasio **FitZone**.\n\n### Arquitectura y Reglas del Dominio:\n* **Invariante de Cupo (BR-05)**: Validación estricta para evitar sobrecupos en clases grupales.\n* **Vigencia de Membresías (BR-06)**: Comprobación de suscripciones vigentes mediante Specifications.\n* **Control de Acceso por Roles (BR-01 a BR-04)**: Autorización granular para Socios, Recepción e Instructores.\n* **Manejo de Errores Empáticos**: Respuestas semánticas (HTTP 400 y 403) ante cualquier infracción de reglas de negocio.\n    ",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/calendario": {
      "get": {
        "tags": [
          "Gimnasio FitZone"
        ],
        "summary": "Consultar el horario de clases y cupos disponibles",
        "description": "Retorna el catálogo completo de clases grupales y cuántos lugares quedan disponibles.\nPermite al socio o a recepción verificar disponibilidad antes de solicitar una reserva.",
        "operationId": "consultar_calendario_api_v1_calendario_get",
        "responses": {
          "200": {
            "description": "Lista completa de clases programadas con cupos disponibles en tiempo real.",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClaseDisponibleDTO"
                  },
                  "type": "array",
                  "title": "Response Consultar Calendario Api V1 Calendario Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clases/{clase_id}": {
      "get": {
        "tags": [
          "Gimnasio FitZone"
        ],
        "summary": "Consultar detalle y aforo de una clase grupal",
        "description": "Obtiene la ficha técnica de una sesión grupal específica, incluyendo aforo total y lugares ocupados en tiempo real.",
        "operationId": "consultar_detalle_clase_api_v1_clases__clase_id__get",
        "parameters": [
          {
            "name": "clase_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Identificador único de la clase (ej. FIT-P001)",
              "examples": [
                "FIT-P001"
              ],
              "title": "Clase Id"
            },
            "description": "Identificador único de la clase (ej. FIT-P001)"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles de horario, cupo total, lugares ocupados y disponibles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetalleClaseDTO"
                }
              }
            }
          },
          "404": {
            "description": "Clase no encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/socios/{socio_id}/reservas": {
      "get": {
        "tags": [
          "Gimnasio FitZone"
        ],
        "summary": "Consultar el historial y estado de reservas de un socio",
        "description": "Entrega todas las reservaciones registradas a nombre de un socio para dar seguimiento a su historial de asistencia.",
        "operationId": "consultar_reservas_de_socio_api_v1_socios__socio_id__reservas_get",
        "parameters": [
          {
            "name": "socio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Identificador único del socio (ej. FIT-C001)",
              "examples": [
                "FIT-C001"
              ],
              "title": "Socio Id"
            },
            "description": "Identificador único del socio (ej. FIT-C001)"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista cronológica de reservaciones (activas, canceladas o asistidas).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReservaDTO"
                  },
                  "title": "Response Consultar Reservas De Socio Api V1 Socios  Socio Id  Reservas Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/socios/{socio_id}/membresia": {
      "get": {
        "tags": [
          "Gimnasio FitZone"
        ],
        "summary": "Consultar estado y vigencia de la membresía de un socio",
        "description": "Permite validar si el socio tiene una membresía activa y al día antes de agendar o permitir acceso.",
        "operationId": "consultar_membresia_socio_api_v1_socios__socio_id__membresia_get",
        "parameters": [
          {
            "name": "socio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Identificador del socio (ej. FIT-C001)",
              "examples": [
                "FIT-C001"
              ],
              "title": "Socio Id"
            },
            "description": "Identificador del socio (ej. FIT-C001)"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles del plan, inicio y vencimiento de la membresía.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembresiaDTO"
                }
              }
            }
          },
          "404": {
            "description": "Socio sin membresía.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reservas": {
      "post": {
        "tags": [
          "Gimnasio FitZone"
        ],
        "summary": "Apartar un lugar en una clase grupal",
        "description": "Recibe la solicitud de reserva y aplica las reglas de negocio estrictas:\n- **Existencia**: La clase y la membresía deben existir en el sistema.\n- **Capacidad (BR-05)**: La clase debe contar con cupo disponible mayor a cero.\n- **Vigencia (BR-06)**: La membresía del socio debe estar activa y dentro de su rango de fechas.\n- **Autorización (BR-01 a BR-04)**: El actor debe poseer un rol válido (Socio o Recepción).",
        "operationId": "apartar_lugar_api_v1_reservas_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComandoReservar",
                "description": "Formulario de reserva que incluye la clase, el socio y el actor que solicita la operación."
              },
              "examples": {
                "reserva_socio": {
                  "summary": "Reserva directa realizada por el Socio",
                  "description": "El socio FIT-C001 reserva por sí mismo un lugar en la clase FIT-P001.",
                  "value": {
                    "clase_id": "FIT-P001",
                    "socio_id": "FIT-C001",
                    "actor_id": "FIT-C001",
                    "actor_rol": "Socio"
                  }
                },
                "reserva_recepcion": {
                  "summary": "Reserva gestionada por el personal de Recepción",
                  "description": "El recepcionista FIT-R001 aparta un lugar para el socio FIT-C002.",
                  "value": {
                    "clase_id": "FIT-P001",
                    "socio_id": "FIT-C002",
                    "actor_id": "FIT-R001",
                    "actor_rol": "Recepción"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Confirmación exitosa con identificador UUID de la reserva generada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaReserva"
                }
              }
            }
          },
          "400": {
            "description": "Fallo por regla de negocio (ej. cupo lleno, membresía vencida, sin reserva activa).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                },
                "examples": {
                  "cupo_lleno": {
                    "summary": "Clase sin cupo disponible",
                    "value": {
                      "error": "Regla de Negocio",
                      "mensaje": "La clase no cuenta con cupo disponible.",
                      "solucion": "Intenta anotarte en la lista de espera o elige otro horario."
                    }
                  },
                  "membresia_vencida": {
                    "summary": "Membresía no vigente o suspendida",
                    "value": {
                      "error": "Regla de Negocio",
                      "mensaje": "La membresía del socio no está vigente o se encuentra suspendida.",
                      "solucion": "Acude a recepción para renovar tu suscripción."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "El actor no tiene los permisos requeridos para ejecutar la acción.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                },
                "example": {
                  "error": "Permiso Denegado",
                  "mensaje": "El usuario no cuenta con rol autorizado para realizar esta acción.",
                  "solucion": "Verifica que el actor posea el rol adecuado (Socio o Recepción)."
                }
              }
            }
          },
          "404": {
            "description": "El recurso solicitado no fue encontrado en el sistema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                },
                "example": {
                  "error": "Regla de Negocio",
                  "mensaje": "El recurso solicitado no existe.",
                  "solucion": "Verifica los identificadores enviados."
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reservas/cancelar": {
      "post": {
        "tags": [
          "Gimnasio FitZone"
        ],
        "summary": "Cancelar una reserva activa",
        "description": "Cancela una reserva activa:\n- Libera el cupo inmediatamente en la clase.\n- Dispara el evento de dominio `ReservaCancelada`.\n- Si existe lista de espera, notifica al siguiente socio formado.",
        "operationId": "cancelar_reserva_api_v1_reservas_cancelar_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComandoCancelar",
                "description": "Datos requeridos para cancelar una reservación activa."
              },
              "examples": {
                "cancelacion_socio": {
                  "summary": "Cancelación solicitada por el propio socio",
                  "value": {
                    "clase_id": "FIT-P001",
                    "socio_id": "FIT-C001",
                    "actor_id": "FIT-C001",
                    "actor_rol": "Socio"
                  }
                },
                "cancelacion_recepcion": {
                  "summary": "Cancelación efectuada por recepción",
                  "value": {
                    "clase_id": "FIT-P001",
                    "socio_id": "FIT-C001",
                    "actor_id": "FIT-R001",
                    "actor_rol": "Recepción"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Confirmación de liberación de lugar en la clase grupal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaAccionDTO"
                }
              }
            }
          },
          "400": {
            "description": "Fallo por regla de negocio (ej. cupo lleno, membresía vencida, sin reserva activa).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                },
                "examples": {
                  "cupo_lleno": {
                    "summary": "Clase sin cupo disponible",
                    "value": {
                      "error": "Regla de Negocio",
                      "mensaje": "La clase no cuenta con cupo disponible.",
                      "solucion": "Intenta anotarte en la lista de espera o elige otro horario."
                    }
                  },
                  "membresia_vencida": {
                    "summary": "Membresía no vigente o suspendida",
                    "value": {
                      "error": "Regla de Negocio",
                      "mensaje": "La membresía del socio no está vigente o se encuentra suspendida.",
                      "solucion": "Acude a recepción para renovar tu suscripción."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "El actor no tiene los permisos requeridos para ejecutar la acción.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                },
                "example": {
                  "error": "Permiso Denegado",
                  "mensaje": "El usuario no cuenta con rol autorizado para realizar esta acción.",
                  "solucion": "Verifica que el actor posea el rol adecuado (Socio o Recepción)."
                }
              }
            }
          },
          "404": {
            "description": "El recurso solicitado no fue encontrado en el sistema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                },
                "example": {
                  "error": "Regla de Negocio",
                  "mensaje": "El recurso solicitado no existe.",
                  "solucion": "Verifica los identificadores enviados."
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reservas/asistencia": {
      "post": {
        "tags": [
          "Gimnasio FitZone"
        ],
        "summary": "Registrar asistencia en puerta de una clase",
        "description": "Marca la asistencia de un socio al llegar al gimnasio:\n- Exige rol de `Recepción` (BR-02).\n- Valida que el socio posea una reserva activa para esa clase.\n- Pasa la reserva a estado `ASISTIDA` y dispara el evento `AsistenciaRegistrada`.",
        "operationId": "registrar_asistencia_api_v1_reservas_asistencia_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComandoRegistrarAsistencia",
                "description": "Verificación de asistencia del socio al inicio de la sesión."
              },
              "examples": {
                "asistencia_recepcion": {
                  "summary": "Validación por recepcionista",
                  "value": {
                    "clase_id": "FIT-P001",
                    "socio_id": "FIT-C001",
                    "actor_id": "FIT-R001",
                    "actor_rol": "Recepción"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Confirmación de asistencia verificada en el acceso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaAccionDTO"
                }
              }
            }
          },
          "400": {
            "description": "Fallo por regla de negocio (ej. cupo lleno, membresía vencida, sin reserva activa).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                },
                "examples": {
                  "cupo_lleno": {
                    "summary": "Clase sin cupo disponible",
                    "value": {
                      "error": "Regla de Negocio",
                      "mensaje": "La clase no cuenta con cupo disponible.",
                      "solucion": "Intenta anotarte en la lista de espera o elige otro horario."
                    }
                  },
                  "membresia_vencida": {
                    "summary": "Membresía no vigente o suspendida",
                    "value": {
                      "error": "Regla de Negocio",
                      "mensaje": "La membresía del socio no está vigente o se encuentra suspendida.",
                      "solucion": "Acude a recepción para renovar tu suscripción."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "El actor no tiene los permisos requeridos para ejecutar la acción.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                },
                "example": {
                  "error": "Permiso Denegado",
                  "mensaje": "El usuario no cuenta con rol autorizado para realizar esta acción.",
                  "solucion": "Verifica que el actor posea el rol adecuado (Socio o Recepción)."
                }
              }
            }
          },
          "404": {
            "description": "El recurso solicitado no fue encontrado en el sistema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuestaDTO"
                },
                "example": {
                  "error": "Regla de Negocio",
                  "mensaje": "El recurso solicitado no existe.",
                  "solucion": "Verifica los identificadores enviados."
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClaseDisponibleDTO": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Identificador único de la clase programada.",
            "examples": [
              "FIT-P001"
            ]
          },
          "nombre": {
            "type": "string",
            "title": "Nombre",
            "description": "Nombre descriptivo de la disciplina o clase deportiva.",
            "examples": [
              "CrossFit Matutino"
            ]
          },
          "horario_inicio": {
            "type": "string",
            "format": "date-time",
            "title": "Horario Inicio",
            "description": "Fecha y hora de inicio de la clase (ISO 8601).",
            "examples": [
              "2026-11-10T07:00:00"
            ]
          },
          "horario_fin": {
            "type": "string",
            "format": "date-time",
            "title": "Horario Fin",
            "description": "Fecha y hora de finalización de la clase (ISO 8601).",
            "examples": [
              "2026-11-10T08:00:00"
            ]
          },
          "lugares_disponibles": {
            "type": "integer",
            "title": "Lugares Disponibles",
            "description": "Número de cupos restantes disponibles para reserva inmediata.",
            "examples": [
              8
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "horario_inicio",
          "horario_fin",
          "lugares_disponibles"
        ],
        "title": "ClaseDisponibleDTO",
        "examples": [
          {
            "horario_fin": "2026-11-10T08:00:00",
            "horario_inicio": "2026-11-10T07:00:00",
            "id": "FIT-P001",
            "lugares_disponibles": 8,
            "nombre": "CrossFit Matutino"
          }
        ]
      },
      "ComandoCancelar": {
        "properties": {
          "clase_id": {
            "type": "string",
            "title": "Clase Id",
            "description": "Identificador único de la clase cuya reserva se cancelará.",
            "examples": [
              "FIT-P001"
            ]
          },
          "socio_id": {
            "type": "string",
            "title": "Socio Id",
            "description": "Identificador del socio que renuncia a su reservación.",
            "examples": [
              "FIT-C001"
            ]
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id",
            "description": "ID del usuario que solicita la cancelación (socio o recepción).",
            "examples": [
              "FIT-C001"
            ]
          },
          "actor_rol": {
            "$ref": "#/components/schemas/Rol",
            "description": "Rol del solicitante para validar autorización.",
            "examples": [
              "Socio"
            ]
          }
        },
        "type": "object",
        "required": [
          "clase_id",
          "socio_id",
          "actor_id",
          "actor_rol"
        ],
        "title": "ComandoCancelar",
        "examples": [
          {
            "actor_id": "FIT-C001",
            "actor_rol": "Socio",
            "clase_id": "FIT-P001",
            "socio_id": "FIT-C001"
          }
        ]
      },
      "ComandoRegistrarAsistencia": {
        "properties": {
          "clase_id": {
            "type": "string",
            "title": "Clase Id",
            "description": "Identificador de la clase deportiva.",
            "examples": [
              "FIT-P001"
            ]
          },
          "socio_id": {
            "type": "string",
            "title": "Socio Id",
            "description": "Identificador del socio que se presenta al gimnasio.",
            "examples": [
              "FIT-C001"
            ]
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id",
            "description": "ID del empleado de recepción o instructor que valida en puerta.",
            "examples": [
              "FIT-R001"
            ]
          },
          "actor_rol": {
            "$ref": "#/components/schemas/Rol",
            "description": "Rol del operador (debe ser Recepción según BR-02).",
            "examples": [
              "Recepción"
            ]
          }
        },
        "type": "object",
        "required": [
          "clase_id",
          "socio_id",
          "actor_id",
          "actor_rol"
        ],
        "title": "ComandoRegistrarAsistencia",
        "examples": [
          {
            "actor_id": "FIT-R001",
            "actor_rol": "Recepción",
            "clase_id": "FIT-P001",
            "socio_id": "FIT-C001"
          }
        ]
      },
      "ComandoReservar": {
        "properties": {
          "clase_id": {
            "type": "string",
            "title": "Clase Id",
            "description": "Identificador único de la clase deportiva programada (ej. FIT-P001).",
            "examples": [
              "FIT-P001"
            ]
          },
          "socio_id": {
            "type": "string",
            "title": "Socio Id",
            "description": "Identificador del socio titular que solicita el lugar (ej. FIT-C001).",
            "examples": [
              "FIT-C001"
            ]
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id",
            "description": "ID del usuario autenticado que efectúa la solicitud (socio o personal).",
            "examples": [
              "FIT-C001"
            ]
          },
          "actor_rol": {
